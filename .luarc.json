{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.2",
  "format.enable": true,
  "hint.enable": true,
  "workspace.useGitIgnore": true,
	"runtime.path": [
	    "kernel/?.lua",
	    "kernel/?/init.lua"
	],
	"workspace.library": [],
